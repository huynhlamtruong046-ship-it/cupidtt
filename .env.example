# Public/client-facing Gemini setting. Configure the real value in the hosting platform's Secrets UI.
GEMINI_API_KEY=""

# AI Studio may inject APP_URL automatically. For a self-managed Cloud Run deployment,
# set this to the public HTTPS URL of the deployed application.
APP_URL=""

# PostgreSQL must be provided by the existing managed database/runtime. Do not invent values,
# commit credentials, or create a second database just to satisfy these variables.
# Use either DATABASE_URL or the individual variables below.
# DATABASE_URL=""
# SQL_HOST=""
# SQL_PORT="5432"
# SQL_USER=""
# SQL_PASSWORD=""
# SQL_DB_NAME=""
# SQL_SSL="true"

# Comma-separated list of verified Firebase email addresses allowed to administer the app.
# The source keeps the current owner email as a fallback; set this explicitly in production.
# ADMIN_EMAILS="admin@example.com"
